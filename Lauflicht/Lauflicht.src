;***************************************

;**** VARIABLEN ****
status  equ 3   ;Statusregister hat Adr. 3
porta   equ 5   ;PORT A hat Adr. 5
portb   equ 6   ;PORT B hat Adr. 6
trisa   equ 5   ;TRIS A hat Adr. 5
trisb   equ 6

rp0     equ 5   ;Umschaltbit zw. Bank 0 & 1
zerofl  equ 2   ;zeroflag im Statusregister (Bit 2)
carry   equ 0   ;carry bit
;Variablen
counter     equ 0ch ;Counter

    device 16f84
    org 0

cold
init
    bcf     portb, 5        ;Sicherstellen, das Ausgang 0 ist (bevor es als Ausgang festgelegt wird) -> Zündimpuls vermeiden
    bsf     status, rp0     ;Umschalten auf Bank 1
    clrf   trisb           ;RB0 - RB7 als Ausgang
    bcf     status, rp0
    incf    counter         ;counter auf 1 initialisieren

loop
;Schalterstellung testen
    movf    porta, w        ;porta einlesen
    andlw   00000001b       ;auf RA0 maskieren -> zerofl wenn ergebnis 0 ist
                            ;wenn zerofl gesetzt, ist Schalter geschlossen (Siehe Schaltkreis)
    btfss   status, zerofl
    goto    s_geschl

s_offen
    RLF     counter
    goto    weiter
s_geschl
    RRF     counter

weiter
    btfsc   status, carry   ;nicht auf portb schreiben, falls carry gesetzt
    goto    loop            ;-> einfach nochmal in den loop
    movf    counter, w
    movwf   portb           ;counter auf portb schreiben
    goto    loop

    end
